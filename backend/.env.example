# ==============================================================================
# CrimeLens - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' inside the 'backend/' directory before launching:
#   Copy-Item .env.example .env
#
# IMPORTANT: DO NOT commit your actual '.env' file containing real passwords to git.
# ==============================================================================

# PostgreSQL 18 Data Warehouse Connection Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=crimelens_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# FastAPI Backend Server Settings
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=False

# Allowed CORS Origins (Comma-separated list of trusted frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Cache TTL Configuration (seconds)
CACHE_TTL_DEFAULT=300
CACHE_TTL_MINING=900
